{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    {
      "plugin": "@nx/storybook/plugin",
      "options": {
        "serveStorybookTargetName": "storybook",
        "buildStorybookTargetName": "build-storybook",
        "testStorybookTargetName": "test-storybook",
        "staticStorybookTargetName": "static-storybook",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    "@habitat-ai/cli/nx-plugin"
  ],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig*.json"],
    "typescriptRuntime": ["{workspaceRoot}/package.json", "{workspaceRoot}/bun.lock"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "{projectRoot}/dist/**",
        "{projectRoot}/types/**",
        "{projectRoot}/example-generated-mod/**",
        "{projectRoot}/mod/**"
      ],
      "cache": true
    },
    "deploy": {
      "dependsOn": [
        "build",
        {
          "projects": ["civ7-cli"],
          "target": "build"
        }
      ],
      "cache": false
    },
    "dev": {
      "cache": false,
      "continuous": true
    },
    "check": {
      "dependsOn": ["typecheck", "check:policy", "^check"],
      "cache": false,
      "outputs": []
    },
    "check:test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default", "typescriptRuntime"],
      "outputs": []
    },
    "check:tools": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default", "typescriptRuntime"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["check:test", "check:tools", "^build"],
      "cache": true,
      "inputs": ["default", "^default", "typescriptRuntime"],
      "outputs": []
    },
    "lint": {
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/vitest.config.ts"]
    },
    "verify": {
      "dependsOn": ["build", "^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  },
  "analytics": false
}
