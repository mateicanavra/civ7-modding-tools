{
  "compilerOptions": {
    "module": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["bun-types"]
  },
  "include": ["civ7.ts"]
}
