{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "swooper-physics-mod",
  "tags": ["kind:app"],
  "targets": {
    "verify:river-contract-probe-live": {
      "command": "bun ./test/live/studio-run-in-game.live.test.ts",
      "dependsOn": [{ "target": "build", "projects": ["control-orpc"] }],
      "cache": false,
      "options": { "cwd": "apps/mods/map/swooper-physics" }
    },
    "build:river-contract-probe": {
      "command": "bun ./test/live/river-contract-probe.ts",
      "dependsOn": [{ "target": "build", "projects": ["mapgen-core", "plugin-files"] }],
      "outputs": ["{projectRoot}/dist/river-contract-probe/**"],
      "cache": false,
      "options": { "cwd": "apps/mods/map/swooper-physics" }
    },
    "verify:elevation-contract-probe-live": {
      "command": "bun ./test/live/studio-run-in-game.live.test.ts",
      "dependsOn": [
        "build:elevation-contract-probe",
        { "target": "build", "projects": ["control-orpc"] }
      ],
      "cache": false,
      "options": { "cwd": "apps/mods/map/swooper-physics" }
    },
    "build:elevation-contract-probe": {
      "command": "bun ./test/live/elevation-contract-probe.ts elevation-native-1018-v1",
      "dependsOn": [{ "target": "build", "projects": ["mapgen-core", "plugin-files"] }],
      "outputs": ["{projectRoot}/dist/elevation-contract-probe/**"],
      "cache": false,
      "options": { "cwd": "apps/mods/map/swooper-physics" }
    },
    "build": {
      "command": "bun ./src/build.ts",
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/dist/mod/**"],
      "options": {
        "cwd": "apps/mods/map/swooper-physics"
      }
    },
    "build:studio-deploy": {
      "command": "bun ./src/build.ts --include-studio-deploy-config",
      "inputs": [
        "default",
        {
          "env": "SWOOPER_STUDIO_DEPLOY_CONFIG_ID"
        }
      ],
      "outputs": ["{projectRoot}/dist/mod/**"],
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/mods/map/swooper-physics"
      }
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "dependsOn": ["check:test", "build"],
      "options": {
        "cwd": "apps/mods/map/swooper-physics"
      }
    },
    "check:test": {
      "command": "tsc -p test/tsconfig.json --noEmit",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/mods/map/swooper-physics"
      }
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["typecheck", "check:policy"],
      "cache": false,
      "outputs": []
    },
    "test": {
      "command": "bun test",
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/vitest.config.ts",
        {
          "env": "SWOOPER_TEST_MAP_SIZE"
        },
        {
          "env": "SWOOPER_TEST_MAP_SEED"
        },
        {
          "env": "SWOOPER_TEST_GAME_SEED"
        }
      ],
      "options": {
        "cwd": "apps/mods/map/swooper-physics"
      }
    },
    "test:studio-run-in-game": {
      "command": "bun test test/runtime/map-bundle-runtime-compatibility.test.ts test/artifact/run-manifest.test.ts",
      "dependsOn": ["build"],
      "cache": true,
      "options": {
        "cwd": "apps/mods/map/swooper-physics"
      }
    },
    "verify:studio-run-in-game-live": {
      "command": "bun ./test/live/studio-run-in-game.live.test.ts",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "cwd": "apps/mods/map/swooper-physics"
      }
    },
    "verify:final-surface-parity": {
      "command": "bun ../../../../plugins/mod/map/swooper-physics/test/recipes/swooper-physics-standard/parity/final-surface-parity.live.test.ts",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "cwd": "apps/mods/map/swooper-physics"
      }
    },
    "gen:run-manifest": {
      "command": "bun ./src/run-manifest.ts",
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "{workspaceRoot}/packages/studio-run-workspace/src/**"],
      "cache": false,
      "options": {
        "cwd": "apps/mods/map/swooper-physics"
      }
    },
    "deploy": {
      "command": "bun ./src/deploy.ts",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "cwd": "apps/mods/map/swooper-physics"
      }
    },
    "deploy:studio": {
      "command": "bun ./src/deploy.ts",
      "dependsOn": ["build:studio-deploy"],
      "cache": false,
      "options": {
        "cwd": "apps/mods/map/swooper-physics"
      }
    }
  }
}
