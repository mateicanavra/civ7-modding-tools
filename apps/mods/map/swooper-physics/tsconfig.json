{
  "extends": ["../../../../tsconfig.base.json", "@civ7/api/map-resolution"],
  "compilerOptions": {
    "outDir": "./dist/types",
    "rootDir": "../../../..",
    "declaration": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": ["bun-types"]
  },
  "include": ["src/**/*.ts"]
}
