{
  "name": "@civ7/cli-mapgen",
  "version": "0.1.0",
  "private": true,
  "description": "Swooper Physics map-generation diagnostics and metrics commands for the Civ7 CLI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "oclif.manifest.json"
  ],
  "scripts": {
    "check:test": "tsc -p test/tsconfig.json --noEmit",
    "clean:dist": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run --project cli-mapgen",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false --incremental false"
  },
  "oclif": {
    "commands": "./dist/commands",
    "topics": {
      "mapgen": {
        "description": "Run and inspect deterministic Swooper Physics map generation"
      },
      "mapgen:diagnostics": {
        "description": "Capture, inventory, compare, and inspect MapGen diagnostic evidence"
      },
      "mapgen:metrics": {
        "description": "Evaluate Swooper Physics product metric studies"
      }
    }
  },
  "dependencies": {
    "@civ7/adapter": "workspace:*",
    "@civ7/config": "workspace:*",
    "@civ7/map-policy": "workspace:*",
    "@oclif/core": "^4.11.4",
    "@swooper/mapgen-core": "workspace:*",
    "@swooper/mapgen-diagnostics": "workspace:*",
    "@swooper/swooper-physics": "workspace:*",
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": "22.22.0"
  }
}
