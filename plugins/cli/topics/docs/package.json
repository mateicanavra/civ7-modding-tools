{
  "name": "@civ7/cli-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Civilization VII documentation commands for the Civ7 CLI.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "oclif.manifest.json"
  ],
  "scripts": {
    "check:test": "tsc -p test/tsconfig.json --noEmit",
    "clean:dist": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run --project cli-docs",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false --incremental false"
  },
  "oclif": {
    "commands": "./dist/commands",
    "topics": {
      "docs": {
        "description": "Serve the project documentation site (Mintlify or Docsify) with optional syncing."
      }
    }
  },
  "dependencies": {
    "@civ7/config": "workspace:*",
    "@civ7/plugin-files": "workspace:*",
    "@oclif/core": "^4.11.4",
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": "22.22.0"
  }
}
