{
  "schemaVersion": 2,
  "id": "validate_boundary_taxonomy_against_workspace_graph",
  "title": "Validate Boundary Taxonomy Against Workspace Graph",
  "placement": {
    "niche": "global/workspace",
    "blueprint": "_self",
    "category": "structure"
  },
  "operation": {
    "kind": "check"
  },
  "ownerProject": "habitat",
  "lane": "enforced",
  "forbids": "drift between declared project kinds, Nx graph tags, boundary config, and taxonomy documentation",
  "why": "Project-kind taxonomy is Habitat Toolkit authority over workspace boundary facts.",
  "remediate": "Align package manifests, nx.json/project metadata, eslint.boundaries.config.mjs, and docs/projects/habitat-harness/taxonomy.md.",
  "message": "Habitat boundary taxonomy validation failed.",
  "pathCoverage": [
    {
      "kind": "exact-path",
      "patterns": [
        "package.json",
        "apps/**/package.json",
        "apps/**/project.json",
        "mods/**/package.json",
        "mods/**/project.json",
        "packages/**/package.json",
        "packages/**/project.json",
        "plugins/**/package.json",
        "plugins/**/project.json",
        "tools/**/package.json",
        "tools/**/project.json",
        "nx.json",
        "eslint.boundaries.config.mjs",
        "docs/projects/habitat-harness/taxonomy.md"
      ]
    },
    {
      "kind": "project-owner"
    }
  ],
  "supportFiles": {
    "baseline": ".habitat/global/workspace/rules/validate_boundary_taxonomy_against_workspace_graph/baseline.json"
  },
  "runner": {
    "name": "habitat",
    "mode": "script",
    "runtime": "bash",
    "files": {
      "script": ".habitat/global/workspace/rules/validate_boundary_taxonomy_against_workspace_graph/check.sh"
    }
  }
}
