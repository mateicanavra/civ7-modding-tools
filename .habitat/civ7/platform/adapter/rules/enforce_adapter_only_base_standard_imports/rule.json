{
  "schemaVersion": 2,
  "id": "enforce_adapter_only_base_standard_imports",
  "title": "Enforce Adapter Only Base Standard Imports",
  "placement": {
    "niche": "civ7/platform/adapter",
    "blueprint": "_self",
    "category": "boundary"
  },
  "operation": {
    "kind": "check"
  },
  "ownerProject": "civ7-adapter",
  "lane": "enforced",
  "forbids": "runtime /base-standard/ imports outside @civ7/adapter",
  "why": "The adapter is the sole runtime owner of Civ7 engine imports; generated @civ7/api declarations are the separate static evidence authority.",
  "remediate": "Move /base-standard/ runtime imports into @civ7/adapter.",
  "message": "Move /base-standard/ runtime imports into @civ7/adapter.",
  "pathCoverage": [
    {
      "kind": "exact-path",
      "patterns": [
        "packages/*/*.ts",
        "packages/*/generated/**/*.ts",
        "packages/*/scripts/*.ts",
        "packages/*/src/**/*.ts",
        "packages/*/test/**/*.ts",
        "packages/*/tools/**/*.ts",
        "packages/plugins/*/*.ts",
        "packages/plugins/*/scripts/**/*.ts",
        "packages/plugins/*/src/**/*.ts",
        "packages/plugins/*/test/**/*.ts",
        "plugins/cli/topics/*/src/**/*.ts"
      ]
    }
  ],
  "supportFiles": {
    "baseline": ".habitat/civ7/platform/adapter/rules/enforce_adapter_only_base_standard_imports/baseline.json"
  },
  "hookCheck": true,
  "runner": {
    "name": "grit",
    "files": {
      "pattern": ".habitat/civ7/platform/adapter/rules/enforce_adapter_only_base_standard_imports/pattern.md"
    },
    "patternName": "enforce_adapter_only_base_standard_imports",
    "acquisition": {
      "kind": "check",
      "roots": ["packages", "plugins/cli/topics"]
    }
  }
}
