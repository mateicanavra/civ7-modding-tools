{
  "schemaVersion": 2,
  "id": "require_sanctioned_direct_control_session_owners",
  "title": "Require Sanctioned Direct Control Session Owners",
  "placement": {
    "niche": "civ7/platform/direct-control/session",
    "blueprint": "_self",
    "category": "boundary"
  },
  "operation": {
    "kind": "check"
  },
  "ownerProject": "control-direct",
  "lane": "enforced",
  "forbids": "caller-local Civ7DirectControlSession construction outside sanctioned session owner files and tests",
  "why": "Studio and tooling code use canonical game-wire doors; direct-control session lifecycle belongs to @civ7/direct-control and the Studio server session service.",
  "remediate": "Use Civ7TunerSession or withCiv7DirectControlSession instead of constructing Civ7DirectControlSession locally.",
  "message": "Use Civ7TunerSession or withCiv7DirectControlSession instead of constructing Civ7DirectControlSession locally.",
  "pathCoverage": [
    {
      "kind": "exact-path",
      "patterns": [
        "apps/*/*.ts",
        "apps/*/*.tsx",
        "apps/*/scripts/**/*.ts",
        "apps/*/scripts/**/*.tsx",
        "apps/*/src/**/*.ts",
        "apps/*/src/**/*.tsx",
        "apps/mods/*/*/*.ts",
        "apps/mods/*/*/*.tsx",
        "apps/mods/*/*/scripts/**/*.ts",
        "apps/mods/*/*/scripts/**/*.tsx",
        "apps/mods/*/*/src/**/*.ts",
        "apps/mods/*/*/src/**/*.tsx",
        "packages/*/*.ts",
        "packages/*/*.tsx",
        "packages/*/scripts/*.ts",
        "packages/*/scripts/*.tsx",
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.tsx",
        "packages/*/tools/**/*.ts",
        "packages/*/tools/**/*.tsx",
        "packages/plugins/*/*.ts",
        "packages/plugins/*/*.tsx",
        "packages/plugins/*/scripts/**/*.ts",
        "packages/plugins/*/scripts/**/*.tsx",
        "packages/plugins/*/src/**/*.ts",
        "packages/plugins/*/src/**/*.tsx",
        "plugins/cli/topics/*/src/**/*.ts"
      ]
    }
  ],
  "supportFiles": {
    "baseline": ".habitat/civ7/platform/direct-control/session/rules/require_sanctioned_direct_control_session_owners/baseline.json"
  },
  "hookCheck": true,
  "runner": {
    "name": "grit",
    "files": {
      "pattern": ".habitat/civ7/platform/direct-control/session/rules/require_sanctioned_direct_control_session_owners/pattern.md"
    },
    "patternName": "require_sanctioned_direct_control_session_owners",
    "acquisition": {
      "kind": "check",
      "roots": ["apps/mapgen-studio/src", "apps/cli", "packages", "plugins/cli/topics"]
    }
  }
}
