{
  "schemaVersion": 2,
  "id": "enforce_swooper_map_script_only_base_standard_imports",
  "title": "Enforce Swooper Map Script Only Base Standard Imports",
  "placement": {
    "niche": "civ7/mapgen/swooper-map-realization",
    "blueprint": "swooper-map-script-realization",
    "category": "boundary"
  },
  "operation": {
    "kind": "check"
  },
  "ownerProject": "swooper-physics-mod",
  "lane": "enforced",
  "forbids": "runtime /base-standard/ imports outside the deployable Swooper map-script realization",
  "why": "Official map modules exist only inside Civ7's embedded runtime. Generated @civ7/api declarations are static evidence; the Swooper mod application is the sole current runtime importer.",
  "remediate": "Move reusable contracts out of the embedded runtime and place necessary /base-standard/ calls inside the Swooper map-script realization.",
  "message": "Only the Swooper map-script realization may import /base-standard/ at runtime.",
  "pathCoverage": [
    {
      "kind": "exact-path",
      "patterns": [
        "apps/*/*.ts",
        "apps/*/src/**/*.ts",
        "apps/*/src/**/*.tsx",
        "apps/*/test/**/*.ts",
        "apps/*/test/**/*.tsx",
        "apps/mods/*/*/src/**/*.ts",
        "apps/mods/*/*/test/**/*.ts",
        "packages/*/*.ts",
        "packages/*/generated/**/*.ts",
        "packages/*/scripts/*.ts",
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.tsx",
        "packages/*/test/**/*.ts",
        "packages/*/test/**/*.tsx",
        "packages/*/tools/**/*.ts",
        "packages/plugins/*/src/**/*.ts",
        "packages/plugins/*/test/**/*.ts",
        "plugins/cli/topics/*/src/**/*.ts",
        "plugins/cli/topics/*/test/**/*.ts",
        "plugins/mod/*/*/authoring/**/*.ts",
        "plugins/mod/*/*/scripts/**/*.ts",
        "plugins/mod/*/*/src/**/*.ts",
        "plugins/mod/*/*/test/**/*.ts"
      ]
    }
  ],
  "supportFiles": {
    "baseline": ".habitat/civ7/mapgen/swooper-map-realization/rules/enforce_swooper_map_script_only_base_standard_imports/baseline.json"
  },
  "hookCheck": true,
  "runner": {
    "name": "grit",
    "files": {
      "pattern": ".habitat/civ7/mapgen/swooper-map-realization/rules/enforce_swooper_map_script_only_base_standard_imports/pattern.md"
    },
    "patternName": "enforce_swooper_map_script_only_base_standard_imports",
    "acquisition": {
      "kind": "check",
      "roots": ["apps", "packages", "plugins"]
    }
  }
}
