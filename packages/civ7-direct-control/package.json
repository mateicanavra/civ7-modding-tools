{
  "name": "@civ7/direct-control",
  "version": "0.1.0",
  "private": true,
  "description": "Direct Civ7 tuner-socket control API for developer tooling.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun-source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./error": {
      "types": "./dist/direct-control-error-boundary.d.ts",
      "bun-source": "./src/direct-control-error-boundary.ts",
      "import": "./dist/direct-control-error-boundary.js",
      "require": "./dist/direct-control-error-boundary.cjs"
    },
    "./game-ui/loading-states": {
      "types": "./dist/game-ui/loading-states.d.ts",
      "bun-source": "./src/game-ui/loading-states.ts",
      "import": "./dist/game-ui/loading-states.js",
      "require": "./dist/game-ui/loading-states.cjs"
    },
    "./live": {
      "types": "./dist/live-control.d.ts",
      "bun-source": "./src/live-control.ts",
      "import": "./dist/live-control.js",
      "require": "./dist/live-control.cjs"
    },
    "./play/diplomacy/first-meet-response": {
      "types": "./dist/play/diplomacy/first-meet-response.d.ts",
      "bun-source": "./src/play/diplomacy/first-meet-response.ts",
      "import": "./dist/play/diplomacy/first-meet-response.js",
      "require": "./dist/play/diplomacy/first-meet-response.cjs"
    },
    "./play/diplomacy/response": {
      "types": "./dist/play/diplomacy/response.d.ts",
      "bun-source": "./src/play/diplomacy/response.ts",
      "import": "./dist/play/diplomacy/response.js",
      "require": "./dist/play/diplomacy/response.cjs"
    },
    "./play/city/town-focus": {
      "types": "./dist/play/city/town-focus.d.ts",
      "bun-source": "./src/play/city/town-focus.ts",
      "import": "./dist/play/city/town-focus.js",
      "require": "./dist/play/city/town-focus.cjs"
    },
    "./play/government/choice": {
      "types": "./dist/play/government/choice.d.ts",
      "bun-source": "./src/play/government/choice.ts",
      "import": "./dist/play/government/choice.js",
      "require": "./dist/play/government/choice.cjs"
    },
    "./play/narrative/choice": {
      "types": "./dist/play/narrative/choice.d.ts",
      "bun-source": "./src/play/narrative/choice.ts",
      "import": "./dist/play/narrative/choice.js",
      "require": "./dist/play/narrative/choice.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "check:test": "tsc -p tsconfig.test.json --noEmit",
    "check:tools": "tsc -p tsconfig.tools.json --noEmit",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false --incremental false"
  },
  "dependencies": {
    "@civ7/map-policy": "workspace:*",
    "typebox": "catalog:"
  },
  "engines": {
    "node": "22.22.0"
  }
}
