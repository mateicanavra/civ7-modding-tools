{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "civ7-cli",
  "tags": ["kind:app"],
  "targets": {
    "check": {
      "executor": "nx:noop",
      "cache": false,
      "outputs": []
    },
    "build:tsc": {
      "command": "tsc -b --force",
      "dependsOn": ["clean:dist", "^build"],
      "cache": true,
      "outputs": ["{projectRoot}/dist/**", "{projectRoot}/tsconfig.tsbuildinfo"],
      "options": {
        "cwd": "packages/cli"
      }
    },
    "build:manifest": {
      "command": "bun run --bun oclif manifest",
      "dependsOn": ["build:tsc"],
      "cache": true,
      "outputs": ["{projectRoot}/oclif.manifest.json"],
      "options": {
        "cwd": "packages/cli"
      }
    },
    "build:bin-mode": {
      "command": "chmod +x bin/run.js",
      "dependsOn": ["build:manifest"],
      "cache": false,
      "outputs": [],
      "options": {
        "cwd": "packages/cli"
      }
    },
    "build": {
      "command": "bun -e \"void 0\"",
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:bin-mode"],
      "options": {
        "cwd": "packages/cli"
      }
    },
    "link:global": {
      "command": "bun link",
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "options": {
        "cwd": "packages/cli"
      }
    },
    "unlink:global": {
      "command": "bun unlink",
      "cache": false,
      "outputs": [],
      "options": {
        "cwd": "packages/cli"
      }
    },
    "readme": {
      "command": "bun run --bun oclif readme",
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["{projectRoot}/README.md"],
      "options": {
        "cwd": "packages/cli"
      }
    },
    "pack:prepare": {
      "command": "bun -e \"void 0\"",
      "cache": false,
      "outputs": [],
      "dependsOn": ["build", "readme"],
      "options": {
        "cwd": "packages/cli"
      }
    },
    "version:readme": {
      "command": "git add README.md",
      "dependsOn": ["readme"],
      "cache": false,
      "outputs": [],
      "options": {
        "cwd": "packages/cli"
      }
    },
    "data:zip:default": {
      "command": "bun bin/run.js data zip default",
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "options": {
        "cwd": "packages/cli"
      }
    },
    "data:unzip:default": {
      "command": "bun bin/run.js data unzip default",
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "options": {
        "cwd": "packages/cli"
      }
    }
  }
}
