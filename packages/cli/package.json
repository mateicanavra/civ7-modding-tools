{
  "name": "@mateicanavra/civ7-cli",
  "version": "0.1.0",
  "description": "CLI for managing Civilization VII modding resources.",
  "license": "MIT",
  "author": "Your Name",
  "main": "dist/index.js",
  "bin": {
    "civ7": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "oclif.manifest.json"
  ],
  "scripts": {
    "check:test": "tsc -p test/tsconfig.json --noEmit",
    "check:tools": "tsc -p bin/tsconfig.json --noEmit",
    "clean:dist": "rimraf dist tsconfig.tsbuildinfo",
    "prepack": "node -e \"\"",
    "pack": "bun pm pack",
    "postpack": "rimraf oclif.manifest.json",
    "prepublishOnly": "node -e \"\"",
    "publish": "bun publish",
    "run": "bun run bin/dev.ts",
    "test": "vitest run --project cli",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false --incremental false",
    "version": "node -e \"\""
  },
  "oclif": {
    "bin": "civ7",
    "commands": "./dist/commands",
    "dirname": "cli",
    "plugins": [
      "@oclif/plugin-help",
      "@civ7/cli-data",
      "@civ7/cli-docs",
      "@civ7/cli-git-mod"
    ],
    "topicSeparator": " ",
    "topics": {
      "game": {
        "description": "Operate a running Civilization VII session through local tooling"
      },
      "game:local-data": {
        "description": "Inspect local Civ7 SQLite, save, and log evidence"
      },
      "game:map": {
        "description": "Read current world, plot, grid, start, and visibility map state"
      },
      "game:play": {
        "description": "Turn-by-turn live-play shortcuts over direct-control"
      },
      "game:play:screen": {
        "description": "Inspect and dismiss App UI display-queue screens (cinematic moments)"
      }
    }
  },
  "dependencies": {
    "@civ7/cli-data": "workspace:*",
    "@civ7/cli-docs": "workspace:*",
    "@civ7/cli-git-mod": "workspace:*",
    "@civ7/config": "workspace:*",
    "@civ7/control-orpc": "workspace:*",
    "@civ7/direct-control": "workspace:*",
    "@oclif/core": "^4.11.4",
    "@oclif/plugin-help": "^6.2.50",
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": "22.22.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com/"
  }
}
