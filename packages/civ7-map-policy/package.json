{
  "name": "@civ7/map-policy",
  "version": "0.1.0",
  "description": "Pure Civ7 map and initial-setup policy facts with deterministic compliance helpers",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js",
      "require": "./dist/setup.cjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup --config scripts/tsup.config.ts",
    "check:test": "tsc -p test/tsconfig.json --noEmit",
    "check:tools": "tsc -p scripts/tsconfig.json --noEmit",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false --incremental false",
    "verify": "bun ./scripts/verify.ts"
  },
  "dependencies": {
    "typebox": "catalog:"
  },
  "devDependencies": {
    "fast-xml-parser": "^5.3.3"
  }
}
