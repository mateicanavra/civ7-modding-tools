{
  "name": "@civ7/map-policy",
  "version": "0.1.0",
  "description": "Pure Civ7 map and initial-setup policy facts with deterministic compliance helpers",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./river-type-metadata-source": {
      "bun-source": "./src/river-type-metadata.source.ts",
      "types": "./dist/river-type-metadata-source.d.ts",
      "import": "./dist/river-type-metadata-source.js",
      "require": "./dist/river-type-metadata-source.cjs"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js",
      "require": "./dist/setup.cjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "check:test": "tsc -p test/tsconfig.json --noEmit",
    "check:tools": "tsc -p scripts/tsconfig.json --noEmit",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false --incremental false"
  },
  "dependencies": {
    "type-fest": "^5.7.0",
    "typebox": "catalog:"
  }
}
