{
  "name": "@mateicanavra/civ7-sdk",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsup --config tsup.config.ts",
    "check:test": "tsc -p test/tsconfig.json --noEmit",
    "check:tools": "tsc -p tsconfig.tools.json --noEmit",
    "clean": "rimraf dist",
    "dev": "rimraf dist && tsup --config tsup.config.ts --watch",
    "prepublishOnly": "node -e \"\"",
    "test": "vitest run --project sdk",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jstoxml": "^7.0.1",
    "lodash-es": "^4.17.23"
  },
  "devDependencies": {
    "@types/jstoxml": "^5.0.0"
  },
  "engines": {
    "node": "22.22.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com/"
  }
}
