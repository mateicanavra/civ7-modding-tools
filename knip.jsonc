{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "includeEntryExports": false,
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "project": ["*.{ts,mts,cts,js,mjs,cjs}"],
      // Habitat acquires the pinned Grit binary through provider construction. TypeBox
      // supports root-level TypeScript references, while string-width deliberately anchors
      // the yargs 17 CommonJS dependency path.
      "ignoreDependencies": ["@getgrit/cli", "oclif", "string-width", "typebox"],
      "biome": {
        "config": ["biome.json", "biome.effect.json"]
      },
      "nx": {
        "config": [
          "nx.json",
          "project.json",
          "{apps,mods,packages,plugins,services}/**/project.json",
          "package.json"
        ]
      },
      // Restrict Vitest's otherwise workspace-global defaults so the source-only Effect
      // reference under .repos is never misclassified as authored workspace code.
      "vitest": {
        "config": ["vitest.config.ts"],
        "entry": [
          "{apps,mods,packages,plugins,services}/**/*.{bench,test,test-d,spec,spec-d}.{js,jsx,ts,tsx,mjs,mts,cjs,cts}"
        ]
      }
    },
    "apps/docs": {
      // Mintlify resolves rooted snippet imports from the docs workspace.
      "entry": ["snippets/**/*.{js,jsx,ts,tsx}"],
      "ignoreDependencies": ["mintlify"]
    },
    "apps/mapgen-studio": {
      "entry": ["test/**/*.type-test.{js,jsx,ts,tsx,mjs,mts,cjs,cts}"]
    },
    "apps/playground": {
      // Each checked-in SDK example is an independently executable authoring entrypoint.
      "entry": ["src/examples/*.ts"]
    },
    "plugins/mod/map/swooper-physics": {
      // Closed Habitat kinds make these declaration-only gateways intentional public
      // entrypoints even when the current recipe graph does not import every owner.
      "entry": [
        "src/maps/catalog/index.ts",
        "src/domain/*/index.ts",
        "src/domain/*/modules/*/index.ts",
        "src/domain/*/model/atoms/index.ts",
        "src/domain/*/modules/*/model/atoms/index.ts",
        "src/domain/*/modules/*/artifacts/index.ts",
        "test/**/*.type-test.{js,jsx,ts,tsx,mjs,mts,cjs,cts}"
      ]
    },
    "apps/mods/map/swooper-physics": {
      // Nx already exposes the app entrypoints. Knip needs only the uncached live proof;
      // the build compiles virtual map sources whose SDK import is invisible to static analysis.
      "entry": ["test/live/*.live.test.ts"],
      "ignoreDependencies": ["@mateicanavra/civ7-sdk"]
    },
    "packages/civ7-adapter": {
      "ignoreUnresolved": ["^/base-standard/"],
      // The map-script builder resolves uri-js dynamically into an esbuild virtual module.
      "ignoreDependencies": ["uri-js"]
    },
    "packages/civ7-map-policy": {
      // Generated setup policy is inspected through its source generator and currentness
      // target; dead-code analysis must not rewrite or narrow protected output.
      "ignore": ["src/setup-parameters.gen.ts"]
    },
    "plugins/cli/topics/data": {
      "entry": ["src/commands/**/*.ts"]
    },
    "plugins/cli/topics/docs": {
      "entry": ["src/commands/**/*.ts"]
    },
    "plugins/cli/topics/git-mod": {
      "entry": ["src/commands/**/*.ts"]
    },
    "plugins/cli/topics/game": {
      "entry": ["src/commands/**/*.ts"],
      // Local-data inspection invokes the host's POSIX `which` command to locate sqlite3.
      "ignoreBinaries": ["which"]
    },
    "plugins/cli/topics/mapgen": {
      "entry": ["src/commands/**/*.ts"]
    },
    "packages/mapgen-core": {
      "entry": ["test/**/*.type-test.{js,jsx,ts,tsx,mjs,mts,cjs,cts}"]
    },
    "packages/sdk": {
      "entry": ["test/**/*.type-test.{js,jsx,ts,tsx,mjs,mts,cjs,cts}"]
    },
    "packages/mapgen-metrics": {
      "entry": ["test/**/*.type-test.{js,jsx,ts,tsx,mjs,mts,cjs,cts}"]
    },
    "packages/mapgen-studio-ui": {
      "entry": ["src/styles/fonts.css", "test/**/*.type-test.{js,jsx,ts,tsx,mjs,mts,cjs,cts}"],
      // The light-canary commands intentionally load Playwright from the isolated,
      // lockfile-owned .ds-sync tool environment. Nx owns the Storybook command,
      // but Knip does not project binaries from its executor-less target string.
      "ignoreDependencies": ["@storybook/test-runner", "playwright", "wait-on"]
    },
    "packages/mapgen-studio-ui/.ds-sync": {
      "entry": [
        "package-*.mjs",
        "resync.mjs",
        "storybook/{compare,probe}.mjs",
        "lib/{preview-rebuild,remote-diff}.mjs",
        "lib/{bundle,common,css-fallback,css,detect,docs,dts,emit,preview-gen-storybook,previews,source-kit,source-storybook,story-imports}.mjs"
      ],
      "project": ["**/*.mjs"],
      // dts.mjs locates React declarations through the installed filesystem tree.
      "ignoreDependencies": ["@types/react"]
    },
    "packages/mapgen-viz": {
      "entry": ["test/**/*.type-test.{js,jsx,ts,tsx,mjs,mts,cjs,cts}"]
    }
  }
}
